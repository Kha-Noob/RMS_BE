# ==========================================
# RESTAURANT MANAGEMENT SYSTEM (RMS BE) .ENV
# ==========================================

# 1. Google Gemini API Key (Dùng cho AI Lọc từ cấm, Đánh giá, Báo cáo & Chatbot)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Cấu hình Cổng thanh toán PayOS (VietQR)
# Lấy API Keys tại Dashboard: https://my.payos.vn/
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY

# 3. Google OAuth2 Login (Đăng nhập Google)
# Lấy Client ID/Secret tại: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# 4. Cấu hình Gửi Email (Gmail SMTP)
# Tạo App Password tại: https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# 5. Database PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swp
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=phamdung.2301
